# real00? alone does not match real010.
Host real00? real010
  # Reuse one connection per target for repeated `ssh realNNN '...'` calls (agents make many).
  # %L (this host) in the path: ~/.ssh is NFS, and a socket only works on the host that made it.
  ControlMaster auto
  ControlPath ~/.ssh/cm/%L-%C
  ControlPersist 10m
  HostName %h.stanford.edu
  User renjt
  StrictHostKeyChecking accept-new
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_rsa


Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  AddKeysToAgent yes
  IdentitiesOnly yes
