# Shared git settings, included from ~/.gitconfig by install_deps.sh.
# Identity (user.name/email) stays in each machine's ~/.gitconfig.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true          # n / N jump between files in a diff
[merge]
	conflictstyle = zdiff3   # conflicts also show the common base (git >= 2.35)
[diff]
	colorMoved = default
